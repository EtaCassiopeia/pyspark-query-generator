# ============================================================
# Local GPU Configuration — RTX 4080 Super (16 GB VRAM)
# Copy to .env:  cp .env.local .env
# ============================================================

# === General ===
PROJECT_ROOT=.
DATA_DIR=data/samples
MODEL_CACHE_DIR=models

# === RAG (Approach 1) ===
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=data/faiss_index
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=deepseek-coder:6.7b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
RAG_TOP_K=3

# === Fine-tuning (Approach 2) — tuned for 16 GB VRAM ===
BASE_MODEL=deepseek-ai/deepseek-coder-6.7b-instruct
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
TRAINING_EPOCHS=3
LEARNING_RATE=2e-4
BATCH_SIZE=2
GRADIENT_ACCUMULATION_STEPS=8

# === vLLM Serving — tuned for 16 GB VRAM ===
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_QUANTIZATION=awq
VLLM_MAX_MODEL_LEN=4096
